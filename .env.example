# ============================================================================
# 环境变量模板（.env.example）
# ============================================================================
# 这是**给人看的说明书**，可以进仓库 —— 因为它里面**没有任何真实值**，
# 只有「需要配哪些变量」和「每个变量去哪拿」。
#
# 用法：
#   1. 复制成 .env      cp .env.example .env
#   2. 按下面说明逐项填上真实值
#   3. .env 已被 .gitignore 忽略（规则 `*.env`），不会被提交
#
# ⚠️ 三条铁律：
#   · 真实密钥只写进 .env，永远不进仓库、不进前端代码
#   · 不要在本文件里填任何真实值 —— 包括只填「前几位」当示例
#     （密钥的固定前缀本身就是特征串，会被误认成泄漏）
#   · 新增变量时，先在这里补上「键名 + 说明」，再往 .env 里填值
# ============================================================================


# ----------------------------------------------------------------------------
# ① CloudBase HTTP API（PostgREST）—— 数据源优先级最高，写入持久
# ----------------------------------------------------------------------------
# 配了这两项，服务启动日志会显示：data source: rest
# 没配则自动降级到 pg 直连，再没有就用本地快照（不持久）。
# 获取位置：CloudBase 控制台 → 环境管理 → API Key 配置 → 服务端 API Key

# 环境 ID。从控制台「复制」取得，不要手打、不要从截图 OCR 读
# （这类随机串肉眼极易看错，曾经少写一个字符导致整条通道报错）
CLOUDBASE_ENV_ID=

# 服务端 API Key（service_role 权限，绕过 RLS）
# ⚠️ 权限很高，只能放服务端环境变量；严禁写进前端代码、严禁提交仓库
CLOUDBASE_API_KEY=


# ----------------------------------------------------------------------------
# ② PostgreSQL 直连（可选）—— 数据源优先级次之
# ----------------------------------------------------------------------------
# 装了 pg 驱动且配了此项时，走直连真库。公网部署**不要**配这个
# （发布平台的 pre-check 会拒绝含 pg 依赖的项目，公网请用 ①）。
# 格式：postgresql://用户名:密码@主机:端口/库名
DATABASE_URL=
# PG_URL 是 DATABASE_URL 的别名，配任意一个即可
PG_URL=

# 本地调试若不需要 SSL 校验，设为 1（默认开启 SSL）
# PG_NO_SSL=


# ----------------------------------------------------------------------------
# ③ 服务端口（可选）
# ----------------------------------------------------------------------------
# 本地起服务时用：PORT=3000 node server.js
# 不填默认 3000。
# PORT=3000

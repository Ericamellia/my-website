# ===== 私密配置（永远不上传）=====
# .env 用来存 API Key、数据库密码（Day 19 起实际使用）
.env
.env.*
*.env

# 例外：配置**模板**要进仓库 —— 它只有键名和说明，没有任何真实值，
# 是给协作者看的「要配哪些变量」。上面 `.env.*` 会连它一起忽略，这里用 ! 捞回来。
!.env.example

# ===== 依赖与日志（以后会用到）=====
node_modules/
*.log

# ===== Python 编译缓存（py_compile / import 的产物，不进仓库）=====
__pycache__/
*.pyc

# ===== 系统与编辑器杂项 =====
.DS_Store
Thumbs.db
.vscode/
.idea/

# ===== WorkBuddy 工作数据（AI 助手的本地记录，与项目无关）=====
.workbuddy/

# ===== 临时探针/调试脚本（用完即弃，不进仓库）=====
.tmp_probe/
